  "resolver_cases": [
    {
      "id": "PATH-EMPTY",
      "given": "Empty PATH",
      "expected": "empty observation; no entries; four not_found resolutions; no current-directory search"
    },
    {
      "id": "PATH-MISSING",
      "given": "Unset PATH",
      "expected": "missing/NOT_SET; no entries; four not_found resolutions"
    },
    {
      "id": "PATH-EMPTY-ENTRY",
      "given": "Absolute local directory, empty item, another directory",
      "expected": "Preserve index; empty item skipped/EMPTY_ENTRY and token=null; relevant prefix may become indeterminate"
    },
    {
      "id": "PATH-RELATIVE",
      "given": "Relative or drive-relative directory",
      "expected": "skipped/RELATIVE_PATH; never resolve against cwd"
    },
    {
      "id": "PATH-DOT",
      "given": "Absolute path containing . or ..",
      "expected": "skipped/UNSUPPORTED_PATH; no resolve"
    },
    {
      "id": "PATH-NETWORK",
      "given": "UNC, mapped remote or unconfirmed drive",
      "expected": "skipped/NETWORK_PATH or UNSUPPORTED_PATH; do not follow or issue metadata requests beyond classification"
    },
    {
      "id": "PATH-REPARSE",
      "given": "Reparse ancestor or target",
      "expected": "skipped/REPARSE_POINT; do not follow"
    },
    {
      "id": "PATH-ADS-DEVICE",
      "given": "ADS, device namespace or quoted directory",
      "expected": "skipped/UNSUPPORTED_PATH before traversal"
    },
    {
      "id": "PATH-LIMIT",
      "given": "257 entries, >32767 total or >4096 per item",
      "expected": "env.PATH error/LIMIT_EXCEEDED; no truncated search; all resolutions indeterminate"
    },
    {
      "id": "PATH-EARLY-UNAVAILABLE",
      "given": "Incomplete directory before an observed program",
      "expected": "indeterminate/INCOMPLETE_SEARCH; first_observed may record candidate but exec observation has no token"
    },
    {
      "id": "PATH-LATE-UNAVAILABLE",
      "given": "Program found before a later incomplete directory",
      "expected": "found remains valid for that program"
    },
    {
      "id": "PATH-SAME-DIRECTORY-EXTENSION",
      "given": "npx.exe inaccessible but npx.cmd present in the same directory",
      "expected": "npx indeterminate because its earlier extension is unresolved; other programs with complete priority prefixes can remain found"
    },
    {
      "id": "PATH-DIRECTORY-AS-CANDIDATE",
      "given": "node.exe is a directory, not an ordinary file",
      "expected": "Not a candidate; no execution or reading directory contents"
    },
    {
      "id": "PATH-PATHEXT-IGNORED",
      "given": "PATHEXT differs but fixed candidate list is unchanged",
      "expected": "Capture PATHEXT difference, retain fixed resolution policy"
    },
    {
      "id": "PATH-ORDER-DUPLICATES",
      "given": "Same PATH elements in different order, duplicates preserved",
      "expected": "PATH token differs; do not sort or deduplicate"
    },
    {
      "id": "PATH-LEXICAL-CASE",
      "given": "Directory spelling differs only in non-drive letter case",
      "expected": "Different lexical token possible; do not claim different file identity"
    }
  ],
  "input_output_cases": [
    {
      "id": "IO-DUPLICATE-KEY",
      "given": "JSON repeats a known key",
      "expected": "E_JSON; reject before schema; do not echo key or raw text"
    },
    {
      "id": "IO-UTF8-BOM",
      "given": "BOM, invalid UTF-8 or unpaired surrogate",
      "expected": "E_JSON; no raw text in stderr"
    },
    {
      "id": "IO-NONFINITE-TRAILING",
      "given": "NaN/Infinity or non-whitespace trailing content",
      "expected": "E_JSON"
    },
    {
      "id": "IO-INPUT-BOUNDS",
      "given": ">1MiB input, depth>16, string>4096, array>2048 or object>128 keys",
      "expected": "E_INPUT_LIMIT using bounded read/preflight; tighter schema limits still apply"
    },
    {
      "id": "IO-MALICIOUS-FREETEXT",
      "given": "Unknown key or display containing a synthetic script or raw path",
      "expected": "E_SCHEMA; safe fixed-pointer error; no reflection into HTML/text"
    },
    {
      "id": "IO-OUTPUT-EXISTS",
      "given": "Explicit output path already exists",
      "expected": "E_OUTPUT_EXISTS; exclusive creation; existing bytes unchanged"
    },
    {
      "id": "IO-OUTPUT-ALIAS",
      "given": "Output is input path or identified hard-link alias",
      "expected": "E_OUTPUT_ALIAS; preserve input"
    },
    {
      "id": "IO-OUTPUT-PARENT",
      "given": "Output parent absent, remote, reparse or unconfirmed local",
      "expected": "Fail closed; no mkdir, network traversal or overwrite"
    },
    {
      "id": "IO-WRITE-FAILURE",
      "given": "Write or close fails on a newly exclusively-created file",
      "expected": "E_OUTPUT_IO; remove only own same-identity file when safe"
    },
    {
      "id": "IO-CLEANUP-FAILURE",
      "given": "Partial output cannot be safely removed",
      "expected": "E_OUTPUT_PARTIAL; do not delete pre-existing or replaced files"
    },
    {
      "id": "IO-STDOUT-PIPE",
      "given": "Broken stdout pipe after serialization",
      "expected": "I/O exit; no promise to retract already-sent bytes"
    },
    {
      "id": "IO-HTML-STDOUT",
      "given": "html requested without --out",
      "expected": "E_ARGUMENT; no browser launch or output"
    },
    {
      "id": "IO-OUTPUT-REBUILD",
      "given": "Input claims to be redacted but supplies free text in a known scalar",
      "expected": "Reject non-whitelist structure; rebuild renderer data from approved fields"
    }
  ]
}
