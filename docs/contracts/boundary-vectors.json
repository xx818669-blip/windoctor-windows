      "constraint": "found token equals the exec observation token."
    },
    {
      "id": "SEM-NOTFOUND-PRESENT",
      "base": "examples/baseline.json",
      "mutations": [
        {
          "op": "replace",
          "path": "/resolutions/node",
          "value": {
            "certainty": "not_found",
            "first_observed": null,
            "entry_index": null,
            "reason": "NOT_FOUND"
          }
        }
      ],
      "expected_code": "E_SEMANTIC",
      "constraint": "not_found requires exec missing/NOT_FOUND."
    },
    {
      "id": "SEM-PATH-MISSING-ENTRIES",
      "base": "examples/baseline.json",
      "mutations": [
        {
          "op": "replace",
          "path": "/observations/env.PATH",
          "value": {
            "state": "missing",
            "display": "MISSING",
            "token": null,
            "reason": "NOT_SET",
            "auth_present": null
          }
        }
      ],
      "expected_code": "E_SEMANTIC",
      "constraint": "Non-present PATH requires an empty path_entries array and consistent resolutions."
    },
