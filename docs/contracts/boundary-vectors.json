  "comparison_cases": [
    {
      "id": "COMPARE-VALUE-CHANGED",
      "given": "Both present with compatible policy, distinct tokens and identical REDACTED displays.",
      "expected": {
        "result": "different",
        "reason": "VALUE_CHANGED",
        "rule_id": "VALUE_DIFFERENCE"
      }
    },
    {
      "id": "COMPARE-AUTH-CONTENT-ONLY",
      "given": "Same canonical endpoint and auth_present=true, different synthetic passwords removed before fingerprinting.",
      "expected": {
        "result": "equal",
        "reason": "VALUE_EQUAL",
        "auth_changed": false,
        "finding": false
      }
    },
    {
      "id": "COMPARE-AUTH-PRESENCE",
      "given": "Same endpoint token; false versus true auth_present.",
      "expected": {
        "result": "different",
        "reason": "AUTH_PRESENCE_CHANGED",
        "auth_changed": true,
        "rule_id": "AUTH_PRESENCE_DIFFERENCE"
      }
    },
    {
      "id": "COMPARE-ENDPOINT-AND-AUTH",
      "given": "Distinct endpoint tokens and different auth_present.",
      "expected": {
        "result": "different",
        "reason": "VALUE_CHANGED",
        "auth_changed": true,
        "rule_id": "VALUE_DIFFERENCE"
      }
    },
    {
      "id": "COMPARE-EMPTY-OR-MISSING-COMPLETE",
      "given": "All states present/empty/missing in both inputs, including deterministic executable not_found.",
      "expected": {
        "snapshot_completion": "complete",
        "comparison_completion": "complete"
      }
    },
    {
      "id": "COMPARE-ALL-UNAVAILABLE",
      "given": "All eleven comparisons are unknown.",
      "expected": {
        "completion": "failed",
        "findings": []
      }
    },
    {
      "id": "RETEST-NO-OLD-FINDING",
      "given": "B and T are equal, but R has new differences.",
      "expected": {
        "items": [],
        "completion": "complete",
        "note": "New differences require a separate B/R comparison report."
      }
    },
    {
      "id": "RETEST-RULE-CHANGED",
      "given": "Old finding is STATE_DIFFERENCE; same subject now has VALUE_DIFFERENCE.",
      "expected": {
        "outcome": "persists",
        "reason": "RETEST_DIFFERENT",
        "preserve_original_finding_id": true
      }
    },
    {
      "id": "RETEST-SAME-PROCESS",
      "given": "R has the same process_instance_id as T.",
      "expected": {
        "note": "No claim that a fresh host environment was inherited."
      }
    },
    {
      "id": "RETEST-ALL-UNKNOWN",
      "given": "Every old finding has an unknown or not_comparable new comparison.",
      "expected": {
        "completion": "failed",
        "outcome_for_each": "unverifiable"
      }
    }
  ],
  "scope_cases": [
    {
      "id": "SCOPE-DIFFERENT-ID",
      "given": "Identical tokens, different scope_id.",
      "expected": {
        "result": "not_comparable",
        "reason": "POLICY_MISMATCH",
        "old_finding_outcome": "unverifiable"
      }
    },
    {
      "id": "SCOPE-UNSUPPORTED-POLICY",
      "given": "privacy=2 in both snapshots; other fields identical.",
      "expected": {
        "result": "not_comparable",
        "reason": "POLICY_MISMATCH"
      }
    },
    {
      "id": "SCOPE-PRECEDENCE",
      "given": "Policy mismatch plus inaccessible observations.",
      "expected": {
        "result": "not_comparable",
        "reason": "POLICY_MISMATCH"
      }
    },
    {
      "id": "SCOPE-MISSING-ARGUMENT",
      "given": "capture lacks --scope-file.",
      "expected": {
        "code": "E_ARGUMENT",
        "exit": 2,
        "snapshot_written": false
      }
    },
    {
      "id": "SCOPE-NOT-JSON",
      "given": "Malformed, duplicated-key or unsupported scope document.",
      "expected": {
        "code": "E_SCOPE_FORMAT",
        "exit": 2,
        "snapshot_written": false
      }
    },
    {
      "id": "SCOPE-DPAPI-UNAVAILABLE",
      "given": "Public ABCD Base64 from the structural case, or inaccessible/other-user protected blob.",
      "expected": {
        "code": "E_SCOPE_UNAVAILABLE",
        "exit": 4,
        "plaintext_fallback": false,
        "snapshot_written": false
      }
    },
    {
      "id": "SCOPE-DECRYPTED-LENGTH",
      "given": "DPAPI decrypts a key whose length is not exactly 32 bytes.",
      "expected": {
        "code": "E_SCOPE_UNAVAILABLE",
        "exit": 4,
        "snapshot_written": false
      }
    },
    {
      "id": "SCOPE-LIFECYCLE",
      "given": "Scope was deleted after B/T/R captures.",
      "expected": {
        "existing_snapshots_comparable": true,
        "new_capture_without_scope": false,
        "no_automatic_recreation": true
      }
    }
  ],
