    },
    {
      "id": "SEM-ID-CONFLICT",
      "inputs": [
        "baseline.json",
        "target.json"
      ],
      "mutation_on": "target",
      "mutations": [
        {
          "op": "replace",
          "path": "/snapshot_id",
          "value": "11111111-1111-4111-8111-111111111111"
        }
      ],
      "expected_code": "E_ID_CONFLICT",
      "constraint": "Same ID with different content is rejected, not compared."
    },
    {
      "id": "SEM-ID-SAME-CONTENT",
      "inputs": [
        "baseline.json",
        "baseline.json"
      ],
      "expected_code": "E_SEMANTIC",
      "constraint": "A snapshot cannot be compared against itself as two different captures."
    },
    {
      "id": "SEM-INVALID-DATE",
      "base": "examples/baseline.json",
      "mutations": [
        {
          "op": "replace",
