{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "windoctor snapshot contract v1",
  "description": "Design contract. Structural validation does not replace MODEL/PRIVACY-IO/OPERATIONS semantic or bounded JSON checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "windoctor.snapshot/1"
    },
    "snapshot_id": {
      "$ref": "#/definitions/uuid"
    },
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "minLength": 20,
      "maxLength": 20,
      "description": "String shape only; a valid UTC calendar date is checked semantically, returning E_SEMANTIC for an impossible date."
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "windoctor"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "not": {
            "pattern": "[^0-9.]"
          },
          "maxLength": 4096
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declared_context": {
          "enum": [
            "terminal",
            "agent",
            "mcp",
            "unspecified"
          ]
        },
        "observed_via": {
          "const": "current_process"
        },
        "process_instance_id": {
          "$ref": "#/definitions/uuid"
        }
      },
      "required": [
        "declared_context",
        "observed_via",
        "process_instance_id"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privacy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "normalization": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "resolver": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "scope_id": {
          "$ref": "#/definitions/hex"
        }
      },
      "required": [
        "privacy",
        "normalization",
        "resolver",
        "scope_id"
      ]
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "win32"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)*$",
          "not": {
            "pattern": "[^0-9.]"
          },
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "platform",
        "version"
      ]
    },
    "completion": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "$ref": "#/definitions/cwdObservation"
        },
        "env.PATH": {
          "$ref": "#/definitions/envObservation"
        },
        "env.PATHEXT": {
          "$ref": "#/definitions/envObservation"
        },
        "env.HTTP_PROXY": {
          "$ref": "#/definitions/proxyObservation"
        },
        "env.HTTPS_PROXY": {
          "$ref": "#/definitions/proxyObservation"
        },
        "env.ALL_PROXY": {
          "$ref": "#/definitions/proxyObservation"
        },
        "env.NO_PROXY": {
          "$ref": "#/definitions/envObservation"
        },
        "exec.node": {
          "$ref": "#/definitions/execObservation"
        },
        "exec.npx": {
          "$ref": "#/definitions/execObservation"
        },
        "exec.codex": {
          "$ref": "#/definitions/execObservation"
        },
        "exec.python": {
          "$ref": "#/definitions/execObservation"
        }
      },
      "required": [
        "cwd",
        "env.PATH",
        "env.PATHEXT",
        "env.HTTP_PROXY",
        "env.HTTPS_PROXY",
        "env.ALL_PROXY",
        "env.NO_PROXY",
        "exec.node",
        "exec.npx",
        "exec.codex",
        "exec.python"
      ]
    },
    "path_entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/pathEntry"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "resolutions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "$ref": "#/definitions/resolution"
        },
        "npx": {
          "$ref": "#/definitions/resolution"
        },
        "codex": {
          "$ref": "#/definitions/resolution"
        },
        "python": {
          "$ref": "#/definitions/resolution"
        }
      },
      "required": [
        "node",
        "npx",
        "codex",
        "python"
      ]
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "captured_at",
    "collector",
    "source",
    "policy",
    "os",
    "completion",
    "observations",
    "path_entries",
    "resolutions"
  ],
  "definitions": {
    "hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "present": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "present"
        },
        "display": {
          "const": "REDACTED"
        },
        "token": {
          "$ref": "#/definitions/hex"
        },
        "reason": {
          "enum": [
            "NONE"
          ]
        },
        "auth_present": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "display",
        "token",
        "reason",
        "auth_present"
      ]
    },
    "presentProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "present"
        },
        "display": {
          "const": "REDACTED"
        },
        "token": {
          "$ref": "#/definitions/hex"
        },
        "reason": {
          "enum": [
            "NONE"
          ]
        },
        "auth_present": {
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "display",
        "token",
        "reason",
        "auth_present"
      ]
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "empty"
        },
        "display": {
          "const": "EMPTY"
        },
        "token": {
          "type": "null"
        },
        "reason": {
          "enum": [
            "NONE"
          ]
        },
        "auth_present": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "display",
        "token",
        "reason",
        "auth_present"
      ]
    },
    "missingEnv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "missing"
        },
        "display": {
          "const": "MISSING"
        },
        "token": {
          "type": "null"
        },
        "reason": {
          "enum": [
            "NOT_SET"
          ]
        },
        "auth_present": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "display",
        "token",
        "reason",
        "auth_present"
      ]
    },
    "missingExec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "missing"
        },
        "display": {
          "const": "MISSING"
        },
        "token": {
          "type": "null"
        },
        "reason": {
          "enum": [
            "NOT_FOUND"
          ]
        },
        "auth_present": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "display",
        "token",
        "reason",
        "auth_present"
      ]
    },
    "inaccessible": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "inaccessible"
        },
        "display": {
          "const": "UNAVAILABLE"
        },
        "token": {
          "type": "null"
        },
        "reason": {
          "enum": [
            "ACCESS_DENIED"
          ]
        },
        "auth_present": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "display",
        "token",
        "reason",
        "auth_present"
      ]
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "skipped"
        },
        "display": {
          "const": "SKIPPED"
        },
        "token": {
          "type": "null"
        },
        "reason": {
          "enum": [
            "EMPTY_ENTRY",
            "RELATIVE_PATH",
            "NETWORK_PATH",
            "REPARSE_POINT",
            "UNSUPPORTED_PATH",
            "INCOMPLETE_SEARCH",
            "TIME_BUDGET"
          ]
        },
        "auth_present": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "display",
        "token",
        "reason",
        "auth_present"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "error"
        },
        "display": {
          "const": "ERROR"
        },
        "token": {
          "type": "null"
        },
        "reason": {
          "enum": [
            "INVALID_VALUE",
            "LIMIT_EXCEEDED",
            "READ_FAILED",
            "TIME_BUDGET",
            "INTERNAL"
          ]
        },
        "auth_present": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "display",
        "token",
        "reason",
        "auth_present"
      ]
    },
    "cwdObservation": {
      "oneOf": [
        {
          "$ref": "#/definitions/present"
        },
        {
          "$ref": "#/definitions/inaccessible"
        },
        {
          "$ref": "#/definitions/skipped"
        },
        {
          "$ref": "#/definitions/error"
        }
      ]
    },
    "envObservation": {
      "oneOf": [
        {
          "$ref": "#/definitions/present"
        },
        {
          "$ref": "#/definitions/empty"
        },
        {
          "$ref": "#/definitions/missingEnv"
        },
        {
          "$ref": "#/definitions/inaccessible"
        },
        {
          "$ref": "#/definitions/skipped"
        },
        {
          "$ref": "#/definitions/error"
        }
      ]
    },
    "proxyObservation": {
      "oneOf": [
        {
          "$ref": "#/definitions/presentProxy"
        },
        {
          "$ref": "#/definitions/empty"
        },
        {
          "$ref": "#/definitions/missingEnv"
        },
        {
          "$ref": "#/definitions/inaccessible"
        },
        {
          "$ref": "#/definitions/skipped"
        },
        {
          "$ref": "#/definitions/error"
        }
      ]
    },
    "execObservation": {
      "oneOf": [
        {
          "$ref": "#/definitions/present"
        },
        {
          "$ref": "#/definitions/missingExec"
        },
        {
          "$ref": "#/definitions/inaccessible"
        },
        {
          "$ref": "#/definitions/skipped"
        },
        {
          "$ref": "#/definitions/error"
        }
      ]
    },
    "pathEntry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "token": {
              "$ref": "#/definitions/hex"
            },
            "status": {
              "const": "searched"
            },
            "reason": {
              "enum": [
                "NONE"
              ]
            }
          },
          "required": [
            "index",
            "token",
            "status",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "token": {
              "$ref": "#/definitions/hex"
            },
            "status": {
              "const": "missing"
            },
            "reason": {
              "enum": [
                "NOT_FOUND"
              ]
            }
          },
          "required": [
            "index",
            "token",
            "status",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "token": {
              "$ref": "#/definitions/hex"
            },
            "status": {
              "const": "inaccessible"
            },
            "reason": {
              "enum": [
                "ACCESS_DENIED"
              ]
            }
          },
          "required": [
            "index",
            "token",
            "status",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "token": {
              "type": "null"
            },
            "status": {
              "const": "skipped"
            },
            "reason": {
              "enum": [
                "EMPTY_ENTRY"
              ]
            }
          },
          "required": [
            "index",
            "token",
            "status",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "token": {
              "$ref": "#/definitions/hex"
            },
            "status": {
              "const": "skipped"
            },
            "reason": {
              "enum": [
                "RELATIVE_PATH",
                "NETWORK_PATH",
                "REPARSE_POINT",
                "UNSUPPORTED_PATH",
                "INCOMPLETE_SEARCH",
                "TIME_BUDGET"
              ]
            }
          },
          "required": [
            "index",
            "token",
            "status",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "token": {
              "$ref": "#/definitions/hex"
            },
            "status": {
              "const": "error"
            },
            "reason": {
              "enum": [
                "INVALID_VALUE",
                "LIMIT_EXCEEDED",
                "READ_FAILED",
                "TIME_BUDGET",
                "INTERNAL"
              ]
            }
          },
          "required": [
            "index",
            "token",
            "status",
            "reason"
          ]
        }
      ]
    },
    "resolution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "certainty": {
              "const": "found"
            },
            "first_observed": {
              "$ref": "#/definitions/hex"
            },
            "entry_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "reason": {
              "const": "NONE"
            }
          },
          "required": [
            "certainty",
            "first_observed",
            "entry_index",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "certainty": {
              "const": "not_found"
            },
            "first_observed": {
              "type": "null"
            },
            "entry_index": {
              "type": "null"
            },
            "reason": {
              "const": "NOT_FOUND"
            }
          },
          "required": [
            "certainty",
            "first_observed",
            "entry_index",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "certainty": {
              "const": "indeterminate"
            },
            "first_observed": {
              "type": "null"
            },
            "entry_index": {
              "type": "null"
            },
            "reason": {
              "const": "INCOMPLETE_SEARCH"
            }
          },
          "required": [
            "certainty",
            "first_observed",
            "entry_index",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "certainty": {
              "const": "indeterminate"
            },
            "first_observed": {
              "$ref": "#/definitions/hex"
            },
            "entry_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "reason": {
              "const": "INCOMPLETE_SEARCH"
            }
          },
          "required": [
            "certainty",
            "first_observed",
            "entry_index",
            "reason"
          ]
        }
      ]
    }
  }
}
